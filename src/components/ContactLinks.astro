---
import { Icon } from '@prosefly/astro-components'
import type { Language } from '@/lib/i18n'
import type { Site } from '@/lib/site'

interface Props {
  links: Site['home']['contact']['links']
  name: string
  avatar: string
  language: Language
}

const { links, name, avatar, language } = Astro.props
const chinese = language === 'zh'
const contacts = links.map((link) => {
  const url = new URL(link.href, Astro.site)
  const email = url.protocol === 'mailto:'
  const telegram = url.hostname === 't.me'
  const handle = email ? url.pathname : `@${url.pathname.split('/')[1]}`
  let action = chinese ? '点击查看个人主页' : 'Open profile'
  if (email) action = chinese ? '点击发送邮件' : 'Send an email'
  else if (telegram)
    action = chinese ? '点击在 Telegram 中联系我' : 'Message me on Telegram'
  return { ...link, email, telegram, handle, action }
})
---

<contact-links>
  <ul class="m-0 flex list-none flex-wrap gap-x-7 gap-y-4 p-0">
    {contacts.map((contact) => (
      <li>
        <a
          class="contact-link"
          href={contact.href}
          aria-label={`${contact.label}: ${contact.handle}`}
          target={contact.email ? undefined : '_blank'}
          rel={contact.email ? undefined : 'noopener noreferrer'}
        >
          <span class="link-label">{contact.label}</span>
          <Icon name="lucide:arrow-up-right" size="14" />
          <span class="contact-card" aria-hidden="true">
            <span class="card-heading">
              <span>{contact.label}</span>
              <Icon name="lucide:arrow-up-right" size="12" />
            </span>
            <span class="card-body">
              {!contact.email && !contact.telegram && (
                <img src={avatar} alt="" width="42" height="42" />
              )}
              <span class="card-identity">
                {contact.email && (
                  <span class="card-label">{chinese ? '收件人' : 'To'}</span>
                )}
                {contact.telegram && (
                  <span class="card-label">
                    {chinese ? '发一条消息' : 'Say hello'}
                  </span>
                )}
                <strong>{name}</strong>
                <span class="card-handle">{contact.handle}</span>
              </span>
              {contact.telegram && (
                <span class="message-icon">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m21 3-6.5 18-4-8L3 9.5 21 3Z M10.5 13 21 3" />
                  </svg>
                </span>
              )}
              {contact.email && (
                <span class="mail-stamp">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                  EMAIL
                </span>
              )}
            </span>
            <span class="card-action">{contact.action}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</contact-links>

<style>
  contact-links {
    display: block;
  }
  .contact-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted);
    transition: color 150ms ease;
  }
  .link-label {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }
  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--ink);
  }
  .contact-link:hover .link-label {
    text-decoration-color: var(--ink);
  }
  .contact-link:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 5px;
  }
  .contact-card {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 0.75rem);
    left: var(--card-left, 0);
    display: none;
    width: min(270px, calc(100vw - 2rem));
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 0.625rem;
    background: var(--pf-surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
    color: var(--ink);
    font-size: 0.8125rem;
    text-align: left;
    pointer-events: none;
  }
  .contact-link:is(:hover, :focus-visible, [data-open]):not([data-dismissed])
    .contact-card {
    display: flex;
    animation: card-appear 150ms ease-out;
  }
  @keyframes card-appear {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1.2;
  }
  .card-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .card-body img {
    flex: 0 0 42px;
    border-radius: 50%;
    object-fit: cover;
  }
  .card-identity {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 0.125rem;
  }
  .card-identity strong {
    font-weight: 560;
    line-height: 1.5;
  }
  .card-handle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .card-label {
    font-size: 0.625rem;
    color: var(--faint);
  }
  .card-action {
    padding-top: 0.625rem;
    border-top: 1px dashed var(--rule);
    color: var(--muted);
    font-size: 0.625rem;
  }
  .message-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--muted);
  }
  .mail-stamp {
    display: flex;
    width: 48px;
    height: 56px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    border: 1px dashed var(--rule);
    color: var(--muted);
    font-size: 0.5625rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-link,
    .contact-card {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  class ContactLinks extends HTMLElement {
    private controller?: AbortController

    connectedCallback() {
      this.controller = new AbortController()
      const { signal } = this.controller
      const links = Array.from(
        this.querySelectorAll<HTMLAnchorElement>('.contact-link'),
      )

      const close = () => {
        links.forEach((link) => {
          link.removeAttribute('data-open')
          link.setAttribute('data-dismissed', '')
        })
      }

      for (const link of links) {
        const positionCard = () => {
          link.removeAttribute('data-dismissed')
          const card = link.querySelector<HTMLElement>('.contact-card')
          if (!card) return
          card.style.display = 'flex'
          const left = link.getBoundingClientRect().left
          const width = card.getBoundingClientRect().width
          const cardLeft = Math.max(
            16,
            Math.min(left, window.innerWidth - width - 16),
          )
          card.style.setProperty('--card-left', `${cardLeft - left}px`)
          card.style.removeProperty('display')
        }

        link.addEventListener('pointerenter', positionCard, { signal })
        link.addEventListener('focus', positionCard, { signal })
        link.addEventListener('blur', () => link.removeAttribute('data-open'), {
          signal,
        })
        link.addEventListener(
          'click',
          (event) => {
            if (
              event.detail === 0 ||
              !window.matchMedia('(hover: none)').matches ||
              link.hasAttribute('data-open')
            )
              return
            event.preventDefault()
            close()
            positionCard()
            link.setAttribute('data-open', '')
          },
          { signal },
        )
      }

      document.addEventListener(
        'pointerdown',
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target))
            close()
        },
        { signal },
      )
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') close()
        },
        { signal },
      )
      window.addEventListener('resize', close, { signal })
    }

    disconnectedCallback() {
      this.controller?.abort()
    }
  }

  if (!customElements.get('contact-links'))
    customElements.define('contact-links', ContactLinks)
</script>
