---
interface Props {
  filePath?: string;
}
const { filePath } = Astro.props;
---

{
  import.meta.env.PROD && (
    <script
      is:inline
      defer
      src="https://analytics.prosefly.com/tracker.js"
      data-org="lepture"
      data-space="d13ccfa7964543babc4f629d6a20eb9d"
      data-filepath={filePath}
    />
  )
}
