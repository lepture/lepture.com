---
import type { Page } from 'astro'
import Pagination from '@/components/Pagination.astro'
import PostList from '@/components/PostList.astro'
import PageIntro from '@/components/PageIntro.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { BlogPost } from '@/lib/content'
import { ui, type Language } from '@/lib/i18n'

interface Props {
  page: Page<BlogPost>
  language?: Language
}

const { page, language = 'en' } = Astro.props
const copy = ui[language]
const pageTitle =
  page.currentPage === 1
    ? copy.blog.title
    : `${copy.blog.title}, ${copy.pagination.page} ${page.currentPage}`
---

<BaseLayout
  title={pageTitle}
  description={copy.blog.description}
  language={language}
  previousUrl={page.url.prev}
  nextUrl={page.url.next}
>
  <section class="page-shell pt-18 pb-20 min-[761px]:pt-16">
    <PageIntro
      title={copy.blog.heading}
      emphasis={copy.blog.emphasis}
      eyebrow={`${copy.blog.title} · ${page.total}`}
      description={copy.blog.description}
    />
  </section>

  <section class="page-shell pb-24" aria-label={copy.blog.title}>
    <PostList posts={page.data} language={language} />
    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      previousHref={page.url.prev}
      nextHref={page.url.next}
      language={language}
    />
  </section>
</BaseLayout>
