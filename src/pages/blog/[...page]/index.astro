---
import type { GetStaticPaths, Page } from 'astro'
import BlogArchive from '@/components/BlogArchive.astro'
import { getBlogPaginationPaths } from '@/lib/blog'
import type { BlogPost } from '@/lib/content'

export const getStaticPaths: GetStaticPaths = ({ paginate }) =>
  getBlogPaginationPaths('en', paginate)

interface Props {
  page: Page<BlogPost>
}

const { page } = Astro.props
---

<BlogArchive page={page} language="en" />
