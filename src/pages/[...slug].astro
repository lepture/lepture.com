---
import { getCollection } from 'astro:content'
import Page from '@/components/Page.astro'
import { getLocalizedPaths, type PageEntry } from '@/lib/content'

export async function getStaticPaths() {
  return getLocalizedPaths(await getCollection('pages'), 'en')
}

interface Props {
  entry: PageEntry
  alternateUrl?: string
}

const { entry, alternateUrl } = Astro.props
---

<Page page={entry} alternateUrl={alternateUrl} />
