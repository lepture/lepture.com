---
import { Icon } from '@prosefly/astro-components'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Language } from '@/lib/i18n'

interface Props {
  title: string
  description?: string
  canonicalPath?: string
  summary?: string
  back?: { href: string; label: string }
  language: Language
  alternateUrl?: string | null
  image?: string
}

const {
  title,
  description,
  canonicalPath,
  summary,
  back,
  language,
  alternateUrl,
  image,
} = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  language={language}
  alternateUrl={alternateUrl}
  image={image}
>
  <article class="detail-shell pb-24">
    <header class="pt-18 min-[761px]:pt-16">
      {back && (
        <a
          class="mb-4 inline-flex items-center gap-1.5 font-mono text-[0.7rem] tracking-[0.08em] text-muted uppercase transition-colors duration-150 hover:text-ink focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[5px] focus-visible:outline-ink motion-reduce:transition-none"
          href={back.href}
        >
          <Icon name="lucide:arrow-left" size="12" />
          {back.label}
        </a>
      )}
      <h1 class="page-title detail-title">{title}</h1>
      {summary && <p class="detail-summary">{summary}</p>}
      <slot name="metadata" />
    </header>
    <div class="prose reading-prose">
      <slot />
    </div>
    <slot name="after-content" />
  </article>
</BaseLayout>

<style>
  .detail-title {
    font-size: clamp(2.5rem, 6vw, 3.25rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .detail-title:lang(zh) {
    letter-spacing: normal;
  }

  .detail-summary {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .reading-prose {
    --tw-prose-body: color-mix(in srgb, var(--ink) 82%, var(--canvas));
    --tw-prose-headings: var(--ink);
    --tw-prose-lead: var(--muted);
    --tw-prose-links: var(--ink);
    --tw-prose-bold: var(--ink);
    --tw-prose-counters: var(--muted);
    --tw-prose-bullets: var(--muted);
    --tw-prose-hr: var(--rule);
    --tw-prose-quotes: var(--tw-prose-body);
    --tw-prose-quote-borders: var(--rule);
    --tw-prose-captions: var(--muted);
    --tw-prose-code: var(--ink);
    --tw-prose-pre-code: var(--ink);
    --tw-prose-pre-bg: var(--pf-surface);
    --tw-prose-th-borders: var(--rule);
    --tw-prose-td-borders: var(--rule);
    max-width: none;
    padding-block: 3rem;
    color: var(--tw-prose-body);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .reading-prose
    :global(:where(h1, h2, h3, h4):not(:where(.not-prose, .not-prose *))) {
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .reading-prose :global(:where(h1):not(:where(.not-prose, .not-prose *))) {
    margin-block: 3rem 1rem;
    font-size: 1.75rem;
  }

  .reading-prose :global(:where(h2):not(:where(.not-prose, .not-prose *))) {
    margin-block: 3rem 1rem;
    font-size: 1.375rem;
  }

  .reading-prose :global(:where(h3):not(:where(.not-prose, .not-prose *))) {
    margin-block: 2rem 0.75rem;
    font-size: 1.1875rem;
  }

  .reading-prose :global(:where(h4):not(:where(.not-prose, .not-prose *))) {
    margin-block: 1.75rem 0.5rem;
    font-size: 1.0625rem;
  }

  .reading-prose
    :global(
      :where(p, ul, ol, pre, table, blockquote, figure):not(
        :where(.not-prose, .not-prose *)
      )
    ) {
    margin-block: 1.5rem;
  }

  .reading-prose
    :global(
      :where(h1, h2, h3, h4):not(:where(.not-prose, .not-prose *))
        + :not(:where(.not-prose, .not-prose *))
    ) {
    margin-top: 0;
  }

  .reading-prose :global(.pf-callout .pf-callout__title) {
    margin-block: 0;
  }

  .reading-prose :global(.pf-callout .pf-callout__slot) {
    line-height: 1.42;
    margin-block-start: 0.5rem;
  }

  .reading-prose :global(:where(strong):not(:where(.not-prose, .not-prose *))) {
    font-weight: 600;
  }

  .reading-prose :global(:where(ul, ol):not(:where(.not-prose, .not-prose *))) {
    padding-inline-start: 1.5em;
  }

  .reading-prose :global(:where(li):not(:where(.not-prose, .not-prose *))) {
    margin-block: 0.4em;
  }

  .reading-prose :global(:where(li p):not(:where(.not-prose, .not-prose *))) {
    margin-block: 0.75em;
  }

  .reading-prose
    :global(:where(blockquote):not(:where(.not-prose, .not-prose *))) {
    padding-inline-start: 1.25rem;
    border-inline-start-width: 2px;
    font-size: 1em;
    font-weight: 400;
    font-style: normal;
    quotes: none;
  }

  .reading-prose :global(:where(code):not(:where(.not-prose, .not-prose *))) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    font-weight: 400;
  }

  .reading-prose
    :global(:where(code):not(:where(.not-prose, .not-prose *)))::before,
  .reading-prose
    :global(:where(code):not(:where(.not-prose, .not-prose *)))::after {
    content: none;
  }

  .reading-prose :global(:where(pre):not(:where(.not-prose, .not-prose *))) {
    padding: 1.25rem;
    border: 1px solid var(--rule);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .reading-prose
    :global(:where(pre code):not(:where(.not-prose, .not-prose *))) {
    font-size: inherit;
  }

  .reading-prose :global(:where(table):not(:where(.not-prose, .not-prose *))) {
    font-size: 0.875em;
    line-height: 1.6;
  }

  .reading-prose
    :global(:where(figcaption):not(:where(.not-prose, .not-prose *))) {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .reading-prose :global(:where(hr):not(:where(.not-prose, .not-prose *))) {
    margin-block: 3rem;
  }

  .reading-prose:lang(zh)
    :global(:where(h1, h2, h3, h4):not(:where(.not-prose, .not-prose *))) {
    letter-spacing: normal;
  }

  .reading-prose > :global(:first-child:not(.not-prose)) {
    margin-top: 0;
  }

  .reading-prose > :global(:last-child:not(.not-prose)) {
    margin-bottom: 0;
  }

  .reading-prose > :global(.footnotes) {
    font-size: 0.875rem;
    padding-block-start: 0.725rem;
    margin-block-start: 3rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .detail-summary {
      font-size: 1.125rem;
    }

    .reading-prose {
      font-size: 1.125rem;
    }

    .reading-prose :global(:where(h1):not(:where(.not-prose, .not-prose *))) {
      font-size: 2rem;
    }

    .reading-prose :global(:where(h2):not(:where(.not-prose, .not-prose *))) {
      font-size: 1.5rem;
    }

    .reading-prose :global(:where(h3):not(:where(.not-prose, .not-prose *))) {
      font-size: 1.25rem;
    }

    .reading-prose :global(:where(h4):not(:where(.not-prose, .not-prose *))) {
      font-size: 1.125rem;
    }
  }
</style>
