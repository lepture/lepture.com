---
import MetadataGrid from '@/components/MetadataGrid.astro'
import ArticleActions from '@/components/ArticleActions.astro'
import DetailLayout from '@/layouts/DetailLayout.astro'
import { formatDate } from '@/lib/format'
import { getFirstParagraph, getReadingStats } from '@/lib/reading'
import { getSite } from '@/lib/site'
import { localizedPath, ui, type Language } from '@/lib/i18n'

interface Props {
  title: string
  canonicalPath: string
  filePath?: string
  description?: string
  summary?: string
  sectionHref: string
  sectionLabel: string
  publishedAt: Date
  updatedAt?: Date
  tags: { title: string; href?: string }[]
  project?: { title: string; href: string }
  language?: Language
  alternateUrl?: string | null
}

const {
  title,
  canonicalPath,
  filePath,
  description,
  summary,
  sectionHref,
  sectionLabel,
  publishedAt,
  updatedAt,
  tags,
  project,
  language = 'en',
  alternateUrl,
} = Astro.props
const copy = ui[language].blog
const content = await Astro.slots.render('default')
const pageDescription = description?.trim() || getFirstParagraph(content)
const { count, minutes } = getReadingStats(content, language)
const numberFormat = new Intl.NumberFormat(language)
const site = (await getSite(language)).data
const permalink = new URL(canonicalPath, Astro.site).href
const authorUrl = new URL(localizedPath('/about', language), Astro.site).href
---

<DetailLayout
  title={title}
  canonicalPath={canonicalPath}
  filePath={filePath}
  description={pageDescription}
  summary={summary}
  back={{ href: sectionHref, label: sectionLabel }}
  language={language}
  alternateUrl={alternateUrl}
  article={{ title, publishedAt, updatedAt }}
>
  <MetadataGrid slot="metadata" columns={4}>
    <div>
      <dt>{copy.date}</dt>
      <dd>
        <a class="u-url u-uid" href={permalink} rel="bookmark">
          <time class="dt-published" datetime={publishedAt.toISOString()}>
            {formatDate(publishedAt, language)}
          </time>
        </a>
        {updatedAt && (
          <time class="dt-updated" datetime={updatedAt.toISOString()} hidden>
            {formatDate(updatedAt, language)}
          </time>
        )}
        <a class="p-author h-card" href={authorUrl} rel="author" hidden>
          {site.home.name}
        </a>
      </dd>
    </div>
    <div>
      <dt>{project ? copy.project : copy.tags}</dt>
      <dd>
        {project ? (
          <a
            class="p-category rounded-sm underline decoration-muted underline-offset-[0.2em] transition-colors duration-150 hover:bg-(--pf-accent-soft) hover:decoration-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink motion-reduce:transition-none"
            href={project.href}
          >
            {project.title}
          </a>
        ) : (
          <>
            {tags.map((tag, index) => (
              <Fragment>
                {index > 0 && (language === 'zh' ? '、' : ', ')}
                {tag.href ? (
                  <a
                    class="p-category rounded-sm underline decoration-muted underline-offset-[0.2em] hover:decoration-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
                    href={tag.href}
                    rel="tag"
                  >
                    {tag.title}
                  </a>
                ) : (
                  <span class="p-category">{tag.title}</span>
                )}
              </Fragment>
            ))}
            {tags.length === 0 && '—'}
          </>
        )}
      </dd>
    </div>
    <div>
      <dt>{copy.words}</dt>
      <dd>{numberFormat.format(count)}</dd>
    </div>
    <div>
      <dt>{copy.length}</dt>
      <dd>
        {numberFormat.format(minutes)} {copy.minutes}
      </dd>
    </div>
  </MetadataGrid>
  <Fragment set:html={content} />
  <Fragment slot="after-content">
    <ArticleActions
      title={title}
      canonicalPath={canonicalPath}
      language={language}
    />
    <slot name="after-content" />
  </Fragment>
</DetailLayout>
